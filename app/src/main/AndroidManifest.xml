<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CyberCarWasher">
        <activity
            android:name=".activities.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activities.CardActivity"
            android:exported="false" />
        <activity
            android:name=".activities.ServicesActivity"
            android:exported="false" />

        <!-- Hidden diagnostics, ported from the admin app. Deliberately not linked from any
             button/menu, and not exported so no other app can start them: reachable only via
             adb, e.g. adb shell am start -n com.meethack.romhack.camp2026/.activities.DebugActivity -->
        <activity
            android:name=".activities.DebugActivity"
            android:exported="true" />
        <activity
            android:name=".activities.CardFormatActivity"
            android:exported="true" />
    </application>

</manifest>